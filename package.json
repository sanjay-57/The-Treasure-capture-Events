{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "vite build && vite build --ssr src/entry-server.tsx --outDir node_modules/.cache/prerender --minify false && node scripts/prerender.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "voice:check": "node --experimental-strip-types scripts/voice-clips.mjs --check",
    "voice:clips": "node --experimental-strip-types scripts/voice-clips.mjs",
    "voice:voices": "node --experimental-strip-types scripts/voice-clips.mjs --voices",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "seo:sitemap": "node --experimental-strip-types scripts/sitemap.mjs"
  },
  "dependencies": {
    "html-to-image": "1.11.11",
    "leaflet": "1.9.4",
    "lenis": "^1.3.26",
    "motion": "^13.4.6",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "1.9.12",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "3.2.4"
  }
}
